                <groupId>com.internalops</groupId>
                <artifactId>inventory</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.internalops</groupId>
                <artifactId>procurement</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.internalops</groupId>
                <artifactId>costing</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.internalops</groupId>
                <artifactId>audit</artifactId>
                <version>${project.version}</version>
            </dependency>
