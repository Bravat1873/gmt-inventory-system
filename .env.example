# Public HTTP port. Change this if port 80 is already in use.
APP_PORT=80

# MySQL database and application account.
MYSQL_DATABASE=gmt_inventory
MYSQL_USER=gmt_app

# Replace both values with different strong passwords before deployment.
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password
