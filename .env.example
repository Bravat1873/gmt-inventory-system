# Public HTTP port. Change this if port 80 is already in use.
APP_PORT=80

# MySQL database. The backend connects as the MySQL root user.
MYSQL_DATABASE=gmt_inventory

# Replace this value with a strong password before production deployment.
MYSQL_ROOT_PASSWORD=root

# Optional local product-image storage directory (defaults to ./data/product-images).
# PRODUCT_IMAGE_ROOT=./data/product-images
